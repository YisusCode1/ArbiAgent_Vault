# --- Red ---
RPC_URL_ARBITRUM_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
ARBISCAN_API_KEY=

# --- Deploy (clave privada de la wallet que despliega, NUNCA subir el .env real) ---
PRIVATE_KEY=

# --- Parametros del constructor del Vault ---
ASSET_ADDRESS=            # direccion del token que el vault va a aceptar (ej. USDC de test)
AI_AGENT_ADDRESS=          # direccion PUBLICA del agente de IA (la privada la maneja el equipo de IA)
TREASURY_ADDRESS=          # wallet que recibe las comisiones de desempeno
AAVE_POOL_ADDRESS=0x794a61358D6845594F94dc1DB02A252b5b4814aD  # Aave V3 Pool en Arbitrum Sepolia
ATOKEN_ADDRESS=             # aToken correspondiente al ASSET_ADDRESS elegido
