# --- Gemini / IA ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=10
GEMINI_MAX_RETRIES=2
CACHE_TTL_SECONDS=60

# --- Web3 / EIP-712 ---
AI_AGENT_ADDRESS=0x_public_address_of_the_ai_agent_wallet
AI_AGENT_PRIVATE_KEY=0x_private_key_of_the_ai_agent_wallet
VAULT_CONTRACT_ADDRESS=0x_deployed_arbiagentvault_address
CHAIN_ID=421614

# --- Internal API auth ---
# Required to call POST /api/v1/rebalance (sent as the X-API-Key header).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=your_internal_api_key_here
